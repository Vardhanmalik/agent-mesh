<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <config>
    <!--
      The default global packages folder (%UserProfile%\.nuget\packages) is locked down
      on this machine (write access denied for the current user), which causes restore
      failures like:
        Access to the path 'C:\Users\<user>\.nuget\packages\<package>\<version>' is denied.
      Redirect the global packages folder to a writable location instead.
    -->
    <add key="globalPackagesFolder" value="C:\Users\vardhanmalik\Documents\NuGetPackages" />
  </config>
</configuration>
